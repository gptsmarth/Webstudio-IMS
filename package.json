{
  "name": "webstudio-ims",
  "version": "1.9.13",
  "private": true,
  "type": "module",
  "description": "WEBSTUDIO Inventory Management System monorepo",
  "scripts": {
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json}\" \"packages/**/*.{ts,tsx,js,jsx,json}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "desktop:dev": "pnpm --filter @webstudio/desktop dev",
    "desktop:build": "pnpm --filter @webstudio/desktop build",
    "desktop:package:win": "bash scripts/release/validate-branding-icons.sh && pnpm --filter @webstudio/desktop package:win",
    "desktop:package:mac": "bash scripts/release/validate-branding-icons.sh && pnpm --filter @webstudio/desktop package:mac",
    "release:sync-branding": "bash scripts/release/sync-branding-assets.sh",
    "release:branding": "bash scripts/release/regenerate-branding-icons.sh",
    "release:android": "bash scripts/release/build-android-apk.sh",
    "release:prepare": "bash scripts/release/prepare-release.sh",
    "release:backend": "bash scripts/release/package-backend.sh",
    "release:checksums": "bash scripts/release/generate-checksums.sh",
    "release:manifest": "python3 scripts/release/lib/generate_manifest.py",
    "mobile:start": "pnpm --filter @webstudio/mobile start",
    "mobile:typecheck": "pnpm --filter @webstudio/mobile typecheck",
    "mobile:flutter:setup": "cd apps/mobile_flutter && bash scripts/setup_platforms.sh",
    "mobile:flutter:test": "cd apps/mobile_flutter && bash scripts/lint_and_test.sh",
    "mobile:flutter:run": "cd apps/mobile_flutter && flutter run"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "packageManager": "pnpm@9.15.0",
  "webstudio": {
    "buildNumber": 13,
    "releaseChannel": "stable",
    "releaseDate": "2026-07-19",
    "gitCommit": "5294ac8e5ce61df612552ce00abd5283b5d4e85c",
    "gitShort": "5294ac8"
  }
}
