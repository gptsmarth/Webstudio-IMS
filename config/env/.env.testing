# WEBSTUDIO IMS — Testing Environment (CI / automated tests)
# Used by pytest with APP_ENV=test overrides where applicable.

APP_ENV=test
APP_VERSION=0.1.0
API_VERSION=1.0
MIN_CLIENT_VERSION=0.1.0

DATABASE_URL=postgresql+asyncpg://webstudio_app:webstudio_app@localhost:5432/webstudio_test

API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=WARNING
LOG_JSON=false

JWT_SECRET=test-jwt-secret-minimum-32-bytes-long

RATE_LIMIT_ENABLED=false
MDNS_ENABLED=false

WEBSTUDIO_TALLY_SCHEDULER=0
WEBSTUDIO_BACKUP_SCHEDULER=0
WEBSTUDIO_NOTIFICATION_SCHEDULER=0
WEBSTUDIO_MAINTENANCE_SCHEDULER=0
WEBSTUDIO_TALLY_CONNECTIVITY_PROBE=0
