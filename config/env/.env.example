# WEBSTUDIO IMS — Environment Variables Template
# Copy to config/env/.env.local or project root .env. Never commit secrets.

# Application
APP_ENV=development
APP_VERSION=0.1.0
API_VERSION=1.0
MIN_CLIENT_VERSION=0.1.0

# Database
POSTGRES_USER=webstudio_app
POSTGRES_PASSWORD=webstudio_app
POSTGRES_DB=webstudio_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://webstudio_app:webstudio_app@localhost:5432/webstudio_dev

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=DEBUG
LOG_JSON=false

# Auth (Sprint 1+)
JWT_SECRET=

# TLS / Internal CA placeholders (production)
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=

# Rate limiting placeholder
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=100

# Tally Integration (Sprint 12+)
TALLY_HOST=
TALLY_PORT=

# Gemini LLM — free tier key from https://aistudio.google.com/apikey
# Powers Add Laptop auto-fetch (specs + product image URL). Leave empty to enter specs manually.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
