# WEBSTUDIO IMS — Environment Variables Template
# Copy to config/env/.env.local or project root .env. Never commit secrets.

# Application
APP_ENV=development
APP_VERSION=0.1.0
API_VERSION=1.0
MIN_CLIENT_VERSION=0.1.0

# Database
POSTGRES_USER=webstudio_app
POSTGRES_PASSWORD=webstudio_app
POSTGRES_DB=webstudio_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://webstudio_app:webstudio_app@localhost:5432/webstudio_dev

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=DEBUG
LOG_JSON=false
WEBSTUDIO_LOG_DIR=
WEBSTUDIO_CRASH_LOG_DIR=

# Auth (Sprint 1+)
JWT_SECRET=

# TLS / Internal CA placeholders (production)
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=

# Rate limiting placeholder
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=100

# Tally Integration (Sprint 12+)
TALLY_HOST=
TALLY_PORT=

# WEBSTUDIO Server (Windows business-hours deployment)
# Must point at the install root (no quotes). Product/brand images live under:
#   {WEBSTUDIO_DATA_ROOT}\assets\product-images
#   {WEBSTUDIO_DATA_ROOT}\assets\brand-logos
# Clients load them via GET /api/v1/product-images/proxy — never paste D:\ paths into Image URL.
WEBSTUDIO_DATA_ROOT=D:\WEBSTUDIO-IMS
WEBSTUDIO_GRACEFUL_SHUTDOWN_SECONDS=30
WEBSTUDIO_SCHEDULER_PERSIST_SECONDS=60
WEBSTUDIO_TALLY_SCHEDULER=1
WEBSTUDIO_BACKUP_SCHEDULER=1
WEBSTUDIO_AUDIT_RETENTION_SCHEDULER=1
WEBSTUDIO_NOTIFICATION_SCHEDULER=1
WEBSTUDIO_MAINTENANCE_SCHEDULER=1
WEBSTUDIO_TALLY_CONNECTIVITY_PROBE=1
WEBSTUDIO_DISCOVERY_CANDIDATES=192.168.1.100,webstudio-server.local

# Gemini LLM — free tier key from https://aistudio.google.com/apikey
# Powers Add Laptop auto-fetch (specs + product image URL). Leave empty to enter specs manually.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
