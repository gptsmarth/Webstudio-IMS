# WEBSTUDIO IMS — Development Environment
# Copy to config/env/.env.local or project root .env

APP_ENV=development
APP_VERSION=0.1.0
API_VERSION=1.0
MIN_CLIENT_VERSION=0.1.0
MIN_DESKTOP_VERSION=0.1.0
MIN_MOBILE_VERSION=0.1.0

POSTGRES_USER=webstudio_app
POSTGRES_PASSWORD=webstudio_app
POSTGRES_DB=webstudio_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://webstudio_app:webstudio_app@localhost:5432/webstudio_dev

API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=DEBUG
LOG_JSON=false
WEBSTUDIO_LOG_DIR=
WEBSTUDIO_CRASH_LOG_DIR=

JWT_SECRET=dev-only-change-me-not-for-production

RATE_LIMIT_ENABLED=false
MDNS_ENABLED=true

WEBSTUDIO_DATA_ROOT=
WEBSTUDIO_TALLY_SCHEDULER=0
WEBSTUDIO_BACKUP_SCHEDULER=0
WEBSTUDIO_NOTIFICATION_SCHEDULER=1
WEBSTUDIO_MAINTENANCE_SCHEDULER=0
WEBSTUDIO_TALLY_CONNECTIVITY_PROBE=0

WEBSTUDIO_DISCOVERY_CANDIDATES=127.0.0.1,localhost
