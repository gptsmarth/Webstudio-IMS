# WEBSTUDIO IMS — Production server environment (generated by installer)
# Copy to D:\WEBSTUDIO-IMS\config\env\.env and customize secrets.

APP_ENV=production
APP_VERSION=0.1.0
API_VERSION=1.0
MIN_CLIENT_VERSION=0.1.0

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true

DATABASE_URL=postgresql+asyncpg://webstudio_app:CHANGE_ME@127.0.0.1:5432/webstudio

# PostgreSQL client tools for backups (auto-detected by finalize-server-setup.ps1 if empty)
POSTGRES_BIN=C:\Program Files\PostgreSQL\18\bin

JWT_SECRET=GENERATED_BY_INSTALLER

WEBSTUDIO_DATA_ROOT=D:\WEBSTUDIO-IMS
WEBSTUDIO_GRACEFUL_SHUTDOWN_SECONDS=30
WEBSTUDIO_SCHEDULER_PERSIST_SECONDS=60
WEBSTUDIO_TALLY_SCHEDULER=1
WEBSTUDIO_BACKUP_SCHEDULER=1
WEBSTUDIO_AUDIT_RETENTION_SCHEDULER=1
WEBSTUDIO_NOTIFICATION_SCHEDULER=1
WEBSTUDIO_MAINTENANCE_SCHEDULER=1
WEBSTUDIO_RELEASE_SYNC_SCHEDULER=1
WEBSTUDIO_RELEASE_SYNC_INTERVAL_SECONDS=900
WEBSTUDIO_RELEASE_UPDATES_ROOT=D:\WEBSTUDIO-IMS\Updates
WEBSTUDIO_RELEASE_CHANNEL=stable

# GitHub release sync (Deployment Center). Token: fine-grained PAT with Contents read.
WEBSTUDIO_GITHUB_REPO=Smarthsingh/WEBSTUDIO-IMS
WEBSTUDIO_GITHUB_TOKEN=

# Optional AI (Settings → Integrations)
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Leave empty for HTTP (port 8000). Set only after placing certs in certs\.
TLS_CERT_PATH=
TLS_KEY_PATH=

CORS_ORIGINS=https://localhost:5173
