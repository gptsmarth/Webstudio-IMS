# WEBSTUDIO IMS — Production server environment (generated by installer)
# Copy to D:\WEBSTUDIO-IMS\config\env\.env and customize secrets.

APP_ENV=production
APP_VERSION=0.1.0
API_VERSION=1.0
MIN_CLIENT_VERSION=0.1.0

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true

DATABASE_URL=postgresql+asyncpg://webstudio_app:CHANGE_ME@localhost:5432/webstudio

JWT_SECRET=GENERATED_BY_INSTALLER

WEBSTUDIO_DATA_ROOT=D:\WEBSTUDIO-IMS
WEBSTUDIO_GRACEFUL_SHUTDOWN_SECONDS=30
WEBSTUDIO_SCHEDULER_PERSIST_SECONDS=60
WEBSTUDIO_TALLY_SCHEDULER=1
WEBSTUDIO_BACKUP_SCHEDULER=1
WEBSTUDIO_AUDIT_RETENTION_SCHEDULER=1
WEBSTUDIO_NOTIFICATION_SCHEDULER=1
WEBSTUDIO_MAINTENANCE_SCHEDULER=1

TLS_CERT_PATH=D:\WEBSTUDIO-IMS\certs\server.crt
TLS_KEY_PATH=D:\WEBSTUDIO-IMS\certs\server.key

CORS_ORIGINS=https://localhost:5173
