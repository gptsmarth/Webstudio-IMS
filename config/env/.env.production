# WEBSTUDIO IMS — Production Environment
# Copy to D:\WEBSTUDIO-IMS\config\env\.env on the dedicated server PC.
# Never commit filled secrets to git.

APP_ENV=production
APP_VERSION=0.1.0
API_VERSION=1.0
MIN_CLIENT_VERSION=0.1.0
MIN_DESKTOP_VERSION=0.1.0
MIN_MOBILE_VERSION=0.1.0

DATABASE_URL=postgresql+asyncpg://webstudio_app:CHANGE_ME@localhost:5432/webstudio_prod

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
LOG_JSON=true
WEBSTUDIO_LOG_DIR=D:\WEBSTUDIO-IMS\logs
WEBSTUDIO_CRASH_LOG_DIR=D:\WEBSTUDIO-IMS\logs\crash

JWT_SECRET=GENERATED_BY_INSTALLER_MIN_32_BYTES

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
MDNS_ENABLED=true

WEBSTUDIO_DATA_ROOT=D:\WEBSTUDIO-IMS
WEBSTUDIO_GRACEFUL_SHUTDOWN_SECONDS=30
WEBSTUDIO_SCHEDULER_PERSIST_SECONDS=60
WEBSTUDIO_TALLY_SCHEDULER=1
WEBSTUDIO_BACKUP_SCHEDULER=1
WEBSTUDIO_AUDIT_RETENTION_SCHEDULER=1
WEBSTUDIO_NOTIFICATION_SCHEDULER=1
WEBSTUDIO_MAINTENANCE_SCHEDULER=1
WEBSTUDIO_TALLY_CONNECTIVITY_PROBE=1
WEBSTUDIO_DISCOVERY_CANDIDATES=192.168.1.100,webstudio-server.local

TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=
